# Copy to .env and adjust. Never commit the real .env.

# --- Postgres (docker compose) ---
POSTGRES_USER=teslapool
POSTGRES_PASSWORD=teslapool
POSTGRES_DB=teslapool
# Host port for the db container (5433 avoids clashing with a local Postgres).
POSTGRES_HOST_PORT=5433

# --- API ---
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgres://teslapool:teslapool@localhost:5433/teslapool
# Integration tests truncate this database; never point it at real data.
DATABASE_URL_TEST=postgres://teslapool:teslapool@localhost:5433/teslapool_test
# Signs session tokens. Generate your own, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-at-least-32-random-characters
JWT_EXPIRES_IN_HOURS=12
# Set to true when served over HTTPS (production).
COOKIE_SECURE=false
# Proxies in front of the API to trust for the client IP (rate limiting):
# 0 = none (direct), 1 = behind the Next.js proxy, 2 = Vercel + Render.
TRUST_PROXY_HOPS=0
# Login/register attempts allowed per IP per 15 minutes.
AUTH_RATE_LIMIT=20

# --- Seed ---
# Password given to every seeded demo account (Jashim, Nusrat, Rafiq, Shirin).
SEED_DEMO_PASSWORD=TeslaPool@2026
