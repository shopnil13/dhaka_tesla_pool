# Copy to .env and adjust. Never commit the real .env.

# --- Postgres (docker compose) ---
POSTGRES_USER=teslapool
POSTGRES_PASSWORD=teslapool
POSTGRES_DB=teslapool
# Host port for the db container (5433 avoids clashing with a local Postgres).
POSTGRES_HOST_PORT=5433

# --- API ---
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgres://teslapool:teslapool@localhost:5433/teslapool
# Integration tests truncate this database; never point it at real data.
DATABASE_URL_TEST=postgres://teslapool:teslapool@localhost:5433/teslapool_test

# --- Seed ---
# Password given to every seeded demo account (Jashim, Nusrat, Rafiq, Shirin).
SEED_DEMO_PASSWORD=TeslaPool@2026
